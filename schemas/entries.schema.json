{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PCGEEntries",
  "description": "Schema for PCGE entries dataset file",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "code": {
        "type": "string",
        "pattern": "^[0-9]{1,6}(?![\\s\\S])"
      },
      "name": {
        "type": "string",
        "minLength": 1,
        "pattern": "\\S"
      },
      "parent_code": {
        "anyOf": [
          {
            "type": "string",
            "pattern": "^[0-9]{1,5}(?![\\s\\S])"
          },
          {
            "type": "null"
          }
        ]
      }
    },
    "required": [
      "code",
      "name",
      "parent_code"
    ],
    "additionalProperties": false
  }
}
